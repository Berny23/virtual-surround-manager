msgid "Hide system tray icon"
msgstr "隐藏系统托盘图标"

msgctxt "@label:combobox"
msgid "Virtual channels"
msgstr "虚拟声道"

msgctxt "@info:description"
msgid "Useful for games that only support 5.1 surround sound. Applied instantly."
msgstr "适用于仅支持 5.1 环绕声的游戏。立即生效。"

