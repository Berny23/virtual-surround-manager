msgid "3D sound for headphones"
msgstr "为耳机带来 3D 音效"

msgctxt "@component"
msgid "Contains HRIR WAV files from HeSuVi. © 2021, Matt Gore. See: hesuvi_license.txt"
msgstr "包含来自 HeSuVi 的 HRIR WAV 文件。© 2021, Matt Gore。参见：hesuvi_license.txt"

msgctxt "@info:credit"
msgid "Developer"
msgstr "开发者"

